#!/bin/sh
# Persistence, verified drive-image backup, data-only formatting, and Rufus-style ISO/DD selection are integrated into the main window.
if [ "${1:-}" = "--persistence" ]; then
  shift
fi
exec /usr/bin/python3 -I -c 'import gi, sys; gi.require_version("Gtk", "3.0"); sys.path.insert(0, "/usr/lib/rufusarm64"); from rufusarm64_drive_backup_formats import install_drive_backup_formats; install_drive_backup_formats(); from rufusarm64_drive_backup_iso import install_drive_backup_iso; install_drive_backup_iso(); from rufusarm64_iso_write_mode import install_iso_write_mode; install_iso_write_mode(); from rufusarm64_integrated import run_rufusarm64; raise SystemExit(run_rufusarm64(["rufusarm64", *sys.argv[1:]]))' "$@"
