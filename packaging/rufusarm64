#!/bin/sh
# GTK 3 is pinned before any packaged dialog import. The embedded Python entry point installs app-scoped appearance and tooltip controls.
if [ "${1:-}" = "--persistence" ]; then
  shift
fi
exec /usr/bin/python3 -I - "$@" <<'PYRUFUSARM64'
"""Isolated GTK 3 launcher with application-scoped product-polish integration."""

import json
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

sys.path.insert(0, "/usr/lib/rufusarm64")

APPEARANCE_SYSTEM = "system"
APPEARANCE_LIGHT = "light"
APPEARANCE_DARK = "dark"
APPEARANCE_MODES = (APPEARANCE_SYSTEM, APPEARANCE_LIGHT, APPEARANCE_DARK)
APPEARANCE_LABELS = {
    APPEARANCE_SYSTEM: "System",
    APPEARANCE_LIGHT: "Light",
    APPEARANCE_DARK: "Dark",
}
APPEARANCE_DESCRIPTIONS = {
    APPEARANCE_SYSTEM: "Follow the desktop appearance observed when RufusArm64 started.",
    APPEARANCE_LIGHT: "Prefer the light variant of the active GTK theme for RufusArm64.",
    APPEARANCE_DARK: "Prefer the dark variant of the active GTK theme for RufusArm64.",
}
GTK_DARK_PROPERTY = "gtk-application-prefer-dark-theme"

MAIN_CONTROL_TOOLTIPS = {
    "image_chooser": "Choose the ISO, disk image, compressed image, virtual disk, or FFU source to inspect before any write.",
    "download_button": "Open verified signed-catalog image acquisition when the installed channel is available.",
    "checksum_button": "Calculate MD5, SHA-1, SHA-256, and SHA-512 for the selected image without modifying it.",
    "ffu_review_button": "Authenticate a supported FFU and review the exact removable target before experimental restoration.",
    "target_combo": "Choose the exact removable whole drive that will be erased only after review and confirmation.",
    "refresh_button": "Rescan connected removable whole drives without changing any device.",
    "qualify_button": "Open the separate destructive USB capacity, bad-block, and fake-capacity qualification workflow.",
    "backup_button": "Save a verified raw, dynamic VHD/VHDX, or one-filesystem ISO/UDF image of the selected drive.",
    "mode_value": "Shows the detected image type, selected write path, and bounded compatibility or boot limitations.",
    "verify": "After writing, read copied data back from the USB and compare it with authenticated source content.",
    "persistence_enabled": "For supported Ubuntu or Debian live media, create separate saved-change storage that can survive reboot.",
    "persistence_size": "Choose persistence capacity in GiB; zero requests the recommended available capacity.",
    "persistence_button": "Run the mandatory read-only persistence compatibility and capacity analysis.",
    "partition_combo": "Choose Automatic, GPT, or MBR for supported Windows media; incompatible combinations are refused.",
    "target_system_combo": "Choose Automatic, UEFI, or x86-family BIOS/CSM for supported Windows installation media.",
    "filesystem_combo": "Choose Automatic, FAT32, or NTFS for supported Windows installation media.",
    "cluster_combo": "Choose the allocation-unit size for a newly created Windows FAT32 or NTFS filesystem.",
    "volume_label": "Set the validated volume label used for the newly created Windows installation filesystem.",
    "driver_chooser": "Optionally stage validated Windows PE driver packages from this folder onto the USB.",
    "dbx_chooser": "Optionally select a Microsoft DBX update used to reject revoked Windows EFI boot files.",
    "dbx_update_button": "Download the current architecture-specific Microsoft DBX update for local inspection.",
    "quick_format": "Keep quick formatting enabled, or disable it to zero-write the complete new data partition first.",
    "bad_block_check": "Zero-write and read back the complete new data partition before formatting; this is slow and destructive.",
