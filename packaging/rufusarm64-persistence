#!/bin/sh
exec /usr/bin/python3 -I - "$@" <<'PYRUFUSARM64PERSISTENCE'
"""Isolated GTK 3 entry point for the dedicated persistent-live wizard."""

import sys

import gi

gi.require_version("Gtk", "3.0")
sys.path.insert(0, "/usr/lib/rufusarm64")

from rufusarm64_i18n import install_secondary_dialog_localization
import rufusarm64_persistence as persistence

install_secondary_dialog_localization()
raise SystemExit(persistence.App().run(None))
PYRUFUSARM64PERSISTENCE
